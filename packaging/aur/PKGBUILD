# Maintainer: Prunr <prunr@example.com>
# AUR package for prunr — local AI background removal
#
# This PKGBUILD downloads the pre-built Linux binary from GitHub Releases.
# CI auto-updates pkgver and sha256sums on each release.

pkgname=prunr-bin
pkgver=0.5.0
pkgrel=1
pkgdesc="Local AI background removal — no cloud, no API keys"
arch=('x86_64')
url="https://github.com/aktiwers/prunr"
license=('Apache-2.0')
depends=('gtk3' 'libxkbcommon' 'fontconfig')
provides=('prunr')
conflicts=('prunr')
source=("${url}/releases/download/v${pkgver}/prunr-linux-x86_64.tar.gz")
sha256sums=('SKIP')

package() {
    # prunr loads its ONNX Runtime from runtime/ beside its real path, so
    # both live in /usr/lib/prunr and /usr/bin only holds a link.
    install -Dm755 prunr "${pkgdir}/usr/lib/prunr/prunr"
    install -Dm644 runtime/libonnxruntime.so "${pkgdir}/usr/lib/prunr/runtime/libonnxruntime.so"
    install -d "${pkgdir}/usr/bin"
    ln -s /usr/lib/prunr/prunr "${pkgdir}/usr/bin/prunr"

    # Desktop entry
    install -Dm644 /dev/stdin "${pkgdir}/usr/share/applications/prunr.desktop" << 'EOF'
[Desktop Entry]
Name=Prunr
Comment=Local AI background removal
Exec=prunr %F
Icon=prunr
Terminal=false
Type=Application
Categories=Graphics;
MimeType=image/png;image/jpeg;image/webp;image/bmp;
EOF
}
